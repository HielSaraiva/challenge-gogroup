{
  "name": "gogroup-operacoes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:agent:synthetic": "tsx --env-file-if-exists=.env.local scripts/verify-agent-synthetic.ts",
    "format": "prettier --write src tests scripts docs README.md package.json next.config.ts drizzle.config.ts vitest.config.ts",
    "format:check": "prettier --check src tests scripts docs README.md package.json next.config.ts drizzle.config.ts vitest.config.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "import:data": "tsx --env-file-if-exists=.env.local scripts/import-data.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.7",
    "groq-sdk": "^0.37.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
